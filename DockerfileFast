# Stage 2: Runtime
FROM us-central1-docker.pkg.dev/ejfexperiments/ejfexperiments/common_backend:1.3.0
WORKDIR /app

# erase all
RUN rm -rf *

# copy needed files
COPY ./package*.json ./
COPY ./dist ./dist
COPY ./node_modules ./node_modules

# Expose port 8080 (Cloud Run expects this)
EXPOSE 8080
CMD ["node", "dist/server.js"]
